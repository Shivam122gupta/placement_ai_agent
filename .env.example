# =================================================================
# AI PLACEMENT AGENT — ENVIRONMENT CONFIGURATION (.env)
# =================================================================

# -----------------------------------------------------------------
# 1. APPLICATION & ENVIRONMENT SETTINGS
# -----------------------------------------------------------------
PROJECT_NAME="AI Placement Agent"
ENVIRONMENT="development"             # "development", "staging", "production"
DEBUG=True                            # Set to False in production
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# -----------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB)
# -----------------------------------------------------------------
# Format: mongodb://<username>:<password>@<host>:<port>/<database_name>?authSource=admin
# Or MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="ai_placement_db"

# -----------------------------------------------------------------
# 3. SECURITY & JWT AUTHENTICATION
# -----------------------------------------------------------------
# Generate secure keys using: openssl rand -hex 32
JWT_SECRET="your-super-secret-jwt-access-key-here"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30        # 30 minutes
REFRESH_TOKEN_EXPIRE_DAYS=7          # 7 days

# -----------------------------------------------------------------
# 4. LLM PROVIDER CONFIGURATION (Groq / OpenAI / Custom API)
# -----------------------------------------------------------------
# Default primary provider (e.g. "groq", "openai", "mock")
LLM_PROVIDER="groq"

# If using Groq (Recommended for fast inference):
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"  # or llama-3.1-8b-instant for cheap tasks

# If using OpenAI / OpenAI-compatible provider:
OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o"

# -----------------------------------------------------------------
# 5. VECTOR DATABASE (Qdrant)
# -----------------------------------------------------------------
# For Local Docker Qdrant: "http://localhost:6333"
# For Qdrant Cloud: "https://xyz.us-east4-0.gcp.cloud.qdrant.io:6333"
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""                     # Leave empty if using local unauthenticated Qdrant

# -----------------------------------------------------------------
# 6. EMBEDDINGS PROVIDER
# -----------------------------------------------------------------
# Options: "local" (uses sentence-transformers/all-MiniLM-L6-v2) or "openai"
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

# -----------------------------------------------------------------
# 7. FILE STORAGE & UPLOADS
# -----------------------------------------------------------------
# Local storage path for uploaded resumes (private, not public)
UPLOAD_STORAGE_DIR="./storage/resumes"
MAX_UPLOAD_SIZE_MB=10

# -----------------------------------------------------------------
# 8. REDIS CACHE & RATE LIMITING (Optional for local, Recommended for Prod)
# -----------------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"
RATE_LIMIT_PER_MINUTE=60

# -----------------------------------------------------------------
# 9. JOB SEARCH EXTERNAL API (Optional: Mock Provider used if empty)
# -----------------------------------------------------------------
JOB_SEARCH_PROVIDER="mock"            # "mock" or "external_api"
JOB_SEARCH_API_KEY=""

# -----------------------------------------------------------------
# 10. EMAIL DISPATCH CONFIGURATION (Resend / Brevo / Gmail SMTP)
# -----------------------------------------------------------------
# Option A: RESEND (Modern Developer API - Recommended, 3000 free emails/month)
# Get free API key from https://resend.com
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY="re_123456789"
# EMAILS_FROM_EMAIL="onboarding@resend.dev"  # or your verified domain e.g. "noreply@yourdomain.com"

# Option B: BREVO (Formerly Sendinblue - 300 free emails/day forever)
# Get SMTP key from https://app.brevo.com/settings/keys/smtp
# EMAIL_PROVIDER="brevo"
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT=587
# SMTP_USER="your-brevo-account-email@gmail.com"
# SMTP_PASSWORD="your-brevo-master-smtp-key"
# SMTP_TLS=True

# Option C: GMAIL APP PASSWORD (100 free emails/day)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_PROVIDER="auto"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASSWORD="your_16_char_app_password"
SMTP_TLS=True
EMAILS_FROM_EMAIL="your_email@gmail.com"
EMAILS_FROM_NAME="Hirxora Career AI"
FRONTEND_URL="http://localhost:5173"


